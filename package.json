{
  "name": "forge",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "description": "Drive the coding agents, terminal and files on a laptop you own, from any browser.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "relay:dev": "pnpm --filter forge-relay-node dev",
    "sprites": "node pixel/build.mjs",
    "test": "node --test 'tests/*.test.mjs'",
    "test:bridge": "cd bridge && python3 -m unittest discover -s tests"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.58.0",
    "@vercel/analytics": "1.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "ws": "^8.21.3"
  }
}
