# Forge — environment
#
# Copy to .env.local and fill in. Then run `pnpm doctor`: it tells you which of
# these are missing and exactly what breaks without each one.
#
#   cp .env.example .env.local
#   pnpm doctor
#
# Documentation for every variable lives in lib/server/env.ts. This file is the
# short version; that one is the source of truth.
#
# ─────────────────────────────────────────────────────────────────────────────
# STEP 1 — required. Without these two, nothing can pair.
# ─────────────────────────────────────────────────────────────────────────────

# Fastest path: a relay on your own machine. Open a second terminal and run
#   pnpm relay:dev
# …then use these two values:
CLOUDFLARE_WORKER_URL=http://127.0.0.1:8787
WORKER_PROXY_SECRET=dev-secret-change-me

# For production, deploy the Worker instead (`cd relay/worker && pnpm deploy`)
# and put its URL here with a real secret:
#   CLOUDFLARE_WORKER_URL=https://forge-relay.<account>.workers.dev
#   WORKER_PROXY_SECRET=<openssl rand -hex 32>
# The SAME secret must be set on the relay (Wrangler secret for the Worker,
# or the environment of the Node relay).

# ─────────────────────────────────────────────────────────────────────────────
# STEP 2 — optional. Accounts, so your machines follow you between browsers.
# ─────────────────────────────────────────────────────────────────────────────
# Leave these blank and Forge runs in device-only mode: pairing still works,
# the session lives in this browser's localStorage.

# Supabase dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Then apply the schema once:
#   supabase db push
# (or paste supabase/migrations/0001_machines.sql into the SQL editor)
# `pnpm doctor` checks that the machines table actually exists.

# ─────────────────────────────────────────────────────────────────────────────
# STEP 3 — optional. Only when the public URL differs from the request host
# (a custom domain, or a self-hosted box behind a proxy).
# ─────────────────────────────────────────────────────────────────────────────

# APP_URL=https://forge.example.com
# NEXT_PUBLIC_APP_URL=https://forge.example.com

# Extra origins allowed to call the write APIs (comma-separated).
# ALLOWED_ORIGINS=https://staging.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Never put these in a file that ships to the browser.
# ─────────────────────────────────────────────────────────────────────────────
# The laptop's daemon token (~/.agentremoted/token) is read by the bridge on the
# laptop and injected into its own requests. It is never sent to this app, and
# it must never appear in a NEXT_PUBLIC_* variable.
