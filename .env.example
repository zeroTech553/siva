# Copy to .env.local and fill in. Everything is optional in development:
# without the relay vars, pairing returns RELAY_NOT_CONFIGURED; without the
# Supabase vars, Forge runs in device-only mode (no accounts).

# -- Relay (required for pairing/terminal) -----------------------------------
# Production: the Cloudflare Worker relay.
# Development: run `pnpm relay:dev` and use http://127.0.0.1:8787
CLOUDFLARE_WORKER_URL=
WORKER_PROXY_SECRET=

# -- Supabase accounts (optional; device-only mode without them) -------------
# Project settings -> API. Apply supabase/migrations/0001_machines.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -- App origin (optional) ----------------------------------------------------
# Only needed when the public URL differs from the deployment URL.
# APP_URL=
# NEXT_PUBLIC_APP_URL=
# ALLOWED_ORIGINS=
